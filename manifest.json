{
  "manifest_version": 3,
  "name": "✨ Lock In Focus Zone ✨",
  "version": "3.1",
  "description": "Block custom URLs and paths with background timer alarms and desktop alerts.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "notifications",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}